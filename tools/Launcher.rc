#include <windows.h>
#include "LauncherVersion.h"
101 ICON "assets/launcher.ico"
102 RCDATA "assets/launcher-background.png"

1 VERSIONINFO
 FILEVERSION G3VR_LAUNCHER_VERSION_RESOURCE
 PRODUCTVERSION G3VR_LAUNCHER_VERSION_RESOURCE
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 BEGIN
  BLOCK "StringFileInfo"
  BEGIN
   BLOCK "040904b0"
   BEGIN
    VALUE "FileDescription", "Gothic 3 VR - Settings and launcher\0"
    VALUE "FileVersion", G3VR_LAUNCHER_VERSION "\0"
    VALUE "InternalName", "Gothic3VRLauncher\0"
    VALUE "OriginalFilename", "Gothic3VRLauncher.exe\0"
    VALUE "ProductName", "Gothic 3 VR\0"
    VALUE "CompanyName", "PeCOS2k5\0"
    VALUE "LegalCopyright", "Copyright (C) 2026 PeCOS2k5. Third-party rights reserved.\0"
    VALUE "ProductVersion", G3VR_LAUNCHER_VERSION "\0"
   END
  END
  BLOCK "VarFileInfo"
  BEGIN
   VALUE "Translation", 0x0409, 1200
  END
 END
